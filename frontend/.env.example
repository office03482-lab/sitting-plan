VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Option 1: keep empty in local dev and let Vite proxy /api -> VITE_API_PROXY_TARGET
VITE_API_URL=

# Option 2: local backend target used by Vite dev server proxy
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
