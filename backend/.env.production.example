# Production environment template for Dr. Girish App

ENVIRONMENT=production

# Database
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=seating_planner
DATABASE_URL=postgresql://erp_app:replace-with-strong-db-password@postgres:5432/seating_planner

# Redis
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=14
OTP_EXPIRATION_MINUTES=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=12
OTP_SEND_MAX_ATTEMPTS=5
OTP_VERIFY_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Email Configuration
SMTP_EMAIL=replace-with-smtp-user@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional one-time admin bootstrap
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=System Administrator

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIRECTORY=/app/uploads

# CORS Origins
CORS_ORIGINS=["https://your-erp-domain.example"]
