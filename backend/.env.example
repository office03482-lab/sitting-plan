# Development environment template for Dr. Girish App

ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///seating_planner.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Leave blank in local development to use the built-in dev-only secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=14
OTP_EXPIRATION_MINUTES=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=12
OTP_SEND_MAX_ATTEMPTS=5
OTP_VERIFY_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Email Configuration
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Supabase admin persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
RELOAD=true

# Optional one-time admin bootstrap
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=System Administrator

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIRECTORY=uploads

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
